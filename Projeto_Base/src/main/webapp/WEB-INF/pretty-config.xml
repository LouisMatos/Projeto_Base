<?xml version="1.0" encoding="UTF-8"?>
<pretty-config xmlns="http://ocpsoft.com/prettyfaces/3.3.3"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://ocpsoft.com/prettyfaces/3.3.3">

    <!--
        Mapeamentos de URL foram removidos intencionalmente.

        A navegação é gerenciada por NavigationController.java usando
        outcomes JSF com ?faces-redirect=true, que preserva o caminho
        real do arquivo .xhtml na barra de endereços do browser.

        Para adicionar novas rotas, edite:
          → br.com.luismatos.adapter.navigation.Rota.java
          → br.com.luismatos.adapter.controller.NavigationController.java
          → layout/topmenu.xhtml
    -->

    <!-- Remove barra final da URL (ex: /principal/ → /principal) -->
    <rewrite match="^/(.*)/$" substitute="/$1" redirect="301"/>

</pretty-config>
